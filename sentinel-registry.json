{
  "registryVersion": "0.2.0",
  "name": "A Core Sentinel",
  "role": "parent-repository",
  "targetTotalPatterns": 320000000,
  "domains": {
    "coding": { "label": "Coding", "targetPatterns": 300000000, "path": "data/coding", "indexPath": "indexes/coding" },
    "automotive": { "label": "Otomotif", "targetPatterns": 10000000, "path": "data/automotive", "indexPath": "indexes/automotive" },
    "general": { "label": "Umum", "targetPatterns": 10000000, "path": "data/general", "indexPath": "indexes/general" }
  },
  "policy": {
    "doNotInventPatterns": true,
    "requireSource": true,
    "requireValidation": true,
    "runtimeRetrievalLimit": 200,
    "storage": "compressed-jsonl-shards",
    "loading": "selective-domain-shards"
  }
}
