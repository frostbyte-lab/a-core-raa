        "backend-server": { "targetPatterns": 30000000, "topics": ["backend", "server", "linux", "process", "websocket", "microservice"] },
        "api-url-http-dns": { "targetPatterns": 25000000, "topics": ["api", "url", "uri", "http", "https", "dns", "tls"] },
        "database-data": { "targetPatterns": 25000000, "topics": ["database", "sql", "nosql", "data", "etl", "cache", "redis"] },
        "git-github": { "targetPatterns": 20000000, "topics": ["git", "github", "repository", "branch", "commit", "actions"] },
